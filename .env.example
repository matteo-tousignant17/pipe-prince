# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
SHADOW_MODE=true               # Set to false ONLY after Pat validates 98% accuracy over 50 loads
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./pipestream.db

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL_ID=C0XXXXXXXXX    # #loads-pending channel ID
SLACK_VALIDATOR_IDS=U0XXXXXXXXX,U0ZZZZZZZZZ  # Comma-separated: Pat, Jack, etc. — add IDs here, no redeploy needed
SLACK_MATTEO_USER_ID=U0YYYYYYYYY             # Matteo's Slack member ID — receives panic alerts on Kill

# ── Inbound webhook ───────────────────────────────────────────────────────────
POSTMARK_WEBHOOK_TOKEN=...       # Shared secret configured in Postmark dashboard

# ── Outbound email ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USERNAME=...
SMTP_PASSWORD=...
FROM_EMAIL=bot@pipestream.ai

# ── Business config ───────────────────────────────────────────────────────────
YARD_MANAGER_EMAIL=yard@example.com
